TOKEN=your_token_here # your discord bot token
APP_PATH= # the path to the data folder, default is ./data
OWNER_IDS=1106558191690584114,481894532082958346 # comma separated Discord user IDs allowed to use /manage and /gulag (affects ALL servers)
BOT_TIMEOUT=10 # after x minutes of inactivity the bot will leave the voice channel
BOT_CHANNEL=channel_name # on every server with a channel of this name, the bot pins the newest sounds
LEGACY_GUILD_ID=664220531557531668 # only when upgrading an existing single-server install: ID of that server, old stats get assigned to it
