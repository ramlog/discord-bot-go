# Discord bot token
TOKEN=your_token_here

# Path that contains the data/ folder (sounds + soundbot.db). Leave empty for the current directory.
APP_PATH=

# Comma separated Discord user IDs allowed to use /manage and /gulag (affects ALL servers)
OWNER_IDS=123456789012345678,234567890123456789

# Minutes of inactivity before the bot leaves the voice channel
BOT_TIMEOUT=10

# On every server with a channel of this name, the bot pins the newest sounds
BOT_CHANNEL=channel_name

# Only when upgrading an existing single-server install: ID of that server, old stats get assigned to it
LEGACY_GUILD_ID=
